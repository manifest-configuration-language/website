{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>manifest-configuration-language/renovate-config"],
  packageRules: [
    {
      description: "Update the MCL JavaScript packages together",
      matchPackageNames: [
        "@manifest-configuration-language/browser",
        "@manifest-configuration-language/language",
      ],
      groupName: "MCL JavaScript packages",
    },
    {
      description: "Pin digests for Dockerfile base images",
      matchDatasources: ["docker"],
      matchManagers: ["dockerfile"],
      pinDigests: true,
    },
  ],
}
