{
  "name": "mcl-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.22.0"
  },
  "scripts": {
    "install:deps": "pnpm install --frozen-lockfile",
    "content:sync": "node scripts/sync-content.mjs",
    "content:sync:astro": "node scripts/sync-content.mjs astro",
    "dev": "pnpm run content:sync && rspress dev",
    "build": "pnpm run content:sync && rspress build",
    "preview": "rspress preview",
    "astro:build": "pnpm run content:sync:astro && pnpm --dir astro-prototype build",
    "lint": "oxlint rspress.config.ts scripts src astro-prototype",
    "format": "oxfmt rspress.config.ts scripts src astro-prototype/src",
    "format:check": "oxfmt --check rspress.config.ts scripts src astro-prototype/src"
  },
  "devDependencies": {
    "@astrojs/react": "7.1.0",
    "@astrojs/starlight": "0.40.0",
    "@rsbuild/plugin-node-polyfill": "1.4.6",
    "@rspress/core": "2.0.23",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "astro": "6.4.8",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "memfs": "4.80.0",
    "path-browserify": "1.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
