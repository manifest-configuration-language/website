import "std:helm" as helm

let options =
  kubeVersion: "1.36.0"
  apiVersions:
    - "apps/v1"
  releaseName: "website"
  namespace: "production"
  values:
    replicaCount: 2
    image:
      repository: "example.test.walnuts.dev/api"
      tag: "v1"
let resources = helm.render("charts/api", options)
emit resources
