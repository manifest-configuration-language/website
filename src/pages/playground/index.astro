---
import Playground from "../../playground/Playground.tsx";
import "../../styles/custom.css";
import "../../styles/playground-shell.css";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="ブラウザー上のWASMでMCLを編集してKubernetesマニフェストを生成します。" />
    <title>MCL Playground</title>
  </head>
  <body>
    <main class="playground-app">
      <nav class="playground-site-nav" aria-label="サイト">
        <a class="playground-site-brand" href="/">MCL</a>
        <a href="/" aria-label="ドキュメント">ドキュメント</a>
        <a href="/getting-started/">導入</a>
        <a href="/guide/">ガイド</a>
        <a href="/reference/">リファレンス</a>
        <a href="/playground/" aria-current="page">Playground</a>
      </nav>
      <Playground client:load />
    </main>
  </body>
</html>
