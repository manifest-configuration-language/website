{
  "render": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "api"
      },
      "spec": {
        "replicas": 2,
        "selector": {
          "matchLabels": {
            "app": "api"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "api"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "api",
                "image": "example.test.walnuts.dev/api:v1"
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "worker"
      },
      "spec": {
        "replicas": 2,
        "selector": {
          "matchLabels": {
            "app": "worker"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "worker"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "worker",
                "image": "example.test.walnuts.dev/worker:v1"
              }
            ]
          }
        }
      }
    }
  ]
}
