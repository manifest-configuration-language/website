{
  "name": "mcl-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-playground-examples.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/prepare-playground-examples.mjs && node scripts/fetch-mcl-reference.mjs",
    "build": "astro build && node scripts/compress-wasm.mjs",
    "migrate:playground-api": "node src/api/migrate.js",
    "test:api": "node --test src/api/*.test.js",
    "test:persistence": "node --test src/playground/*.test.mjs",
    "preview": "astro preview",
    "precheck": "node scripts/prepare-playground-examples.mjs",
    "check": "astro check",
    "lint": "oxlint src scripts",
    "format:check": "oxfmt --check src/api src/playground src/pages src/styles/custom.css scripts astro.config.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1155.0",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/merge": "6.12.3",
    "@codemirror/search": "6.6.0",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.15",
    "@headless-tree/core": "1.7.0",
    "@headless-tree/react": "1.7.0",
    "@hono/node-server": "2.1.5",
    "@manifest-configuration-language/browser": "0.3.12",
    "@manifest-configuration-language/language": "0.3.12",
    "@replit/codemirror-vim": "6.4.0",
    "@replit/codemirror-vscode-keymap": "6.0.2",
    "@zip.js/zip.js": "2.24.0",
    "cmdk": "1.1.1",
    "dexie": "4.4.7",
    "hono": "4.13.13",
    "i18next": "26.5.5",
    "ioredis": "6.0.0",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.1",
    "react-resizable-panels": "4.14.6",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@astrojs/react": "7.1.0",
    "@astrojs/starlight": "0.42.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "astro": "7.2.10",
    "fake-indexeddb": "6.2.6",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "6.0.2"
  },
  "engines": {
    "node": ">=24.22.0"
  },
  "packageManager": "pnpm@12.14.0"
}
