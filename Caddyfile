{
	admin off
}

:8080 {
	root * /srv
	@playgroundShare path_regexp playgroundShare ^/playground/s/[A-Za-z0-9_-]{22}/?$
	rewrite @playgroundShare /playground/index.html
	encode zstd gzip
	file_server {
		precompressed br
	}

	header {
		Content-Security-Policy "frame-ancestors 'none'"
		Cross-Origin-Resource-Policy same-origin
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Vary Accept-Encoding
	}

	@fingerprinted path_regexp fingerprint ^/_astro/.+[.-][A-Za-z0-9_-]{8,}\.(avif|css|gif|ico|jpe?g|js|png|svg|wasm|webp|woff2?)$
	header @fingerprinted Cache-Control "public, max-age=31536000, immutable"

	@mutable {
		path_regexp mutable \.(wasm|js)$
		not path_regexp fingerprint ^/_astro/.+[.-][A-Za-z0-9_-]{8,}\.(avif|css|gif|ico|jpe?g|js|png|svg|wasm|webp|woff2?)$
	}
	header @mutable Cache-Control no-cache

	@html path_regexp html ^/(.*\.html|(.*/)?$)
	header @html Cache-Control no-cache

	@wasm path *.wasm
	header @wasm Content-Type application/wasm
}
