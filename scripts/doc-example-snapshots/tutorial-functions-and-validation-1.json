{
  "render": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "catalog"
      },
      "spec": {
        "replicas": 3,
        "selector": {
          "matchLabels": {
            "app": "catalog"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "catalog"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "catalog",
                "image": "example.test.walnuts.dev/catalog:v1"
              }
            ]
          }
        }
      }
    }
  ]
}
