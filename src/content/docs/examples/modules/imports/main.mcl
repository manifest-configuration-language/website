import "./components.mcl" as components

let deployment =
  apiVersion: "apps/v1"
  kind: "Deployment"
  metadata:
    name: components.resourceName("sample", "api")
    labels:
      app: "sample-api"
  spec:
    replicas: components.replicas
    selector:
      matchLabels:
        app: "sample-api"
    template:
      metadata:
        labels:
          app: "sample-api"
      spec:
        containers:
          - name: "api"
            image: "example.test.walnuts.dev/api:v1"

emit deployment
